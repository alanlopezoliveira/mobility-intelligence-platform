# Application
APP_ENV=development
APP_NAME=Mobility Intelligence Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=es

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Frontend
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=mobility
POSTGRES_USER=mobility_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mobility_user:change_me@db:5432/mobility

# Data
DATA_ROOT=/app/data
BRONZE_DATA_PATH=/app/data/bronze
SILVER_DATA_PATH=/app/data/silver
GOLD_DATA_PATH=/app/data/gold

# Models
MODEL_ROOT=/app/models
PRODUCTION_MODEL_PATH=/app/models/production
MODEL_VERSION=latest

# Provider
DEFAULT_PROVIDER=bicimad
DEFAULT_CITY=Madrid
DEFAULT_COUNTRY=Spain

# Forecasting
DEFAULT_FORECAST_HORIZON_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000